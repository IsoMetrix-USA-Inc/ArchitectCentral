{
  "ConnectionStrings": {
    "PostgreSQL": ""
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "EmbeddingDeploymentName": "text-embedding-ada-002"
  },
  "VectorStore": {
    "Collections": {
      "ADRs": "adr_collection",
      "Guidelines": "guideline_collection",
      "Diagrams": "diagram_collection"
    },
    "UseV2Schema": false,
    "EnableMetadataEnrichment": true,
    "EnableQualityScoring": true
  },
  "DocumentProcessing": {
    "DocsPath": "",
    "ChunkSize": 600,
    "ChunkOverlap": 100,
    "MinChunkSize": 50,
    "MergeShortChunks": true,
    "UseEnhancedChunking": true,
    "OverlapPercentage": 0.15,
    "TrackOverlapPositions": true,
    "BoundaryStrategy": "Semantic",
    "PreserveCodeBlocks": true,
    "PreserveSections": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
